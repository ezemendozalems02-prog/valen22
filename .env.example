# ── Mercado Pago ─────────────────────────────────────────────────────────────
# Credenciales de la aplicación (Mercado Pago Developers → Tus integraciones).
# Usar credenciales de PRUEBA en local y de PRODUCCIÓN solo en Vercel.
# El Access Token es SECRETO: solo se usa en el servidor, nunca en el navegador.
MERCADO_PAGO_ACCESS_TOKEN=
NEXT_PUBLIC_MERCADO_PAGO_PUBLIC_KEY=
# Clave secreta del webhook (panel de la app → Webhooks → Clave secreta).
# Si está vacía, el webhook funciona pero SIN validar la firma x-signature.
MERCADO_PAGO_WEBHOOK_SECRET=

# ── Sitio ────────────────────────────────────────────────────────────────────
# URL pública sin barra final. En local con túnel: la URL del túnel.
# En producción: https://tudominio.com
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# ── Supabase ─────────────────────────────────────────────────────────────────
# Project Settings → API. La Service Role Key es SECRETA: solo servidor.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# ── Email de confirmación (opcional, vía Resend) ─────────────────────────────
# Si se completan, el webhook envía un correo al aprobar el pago.
# RESEND_API_KEY=re_xxxxxxxx
# CONFIRMATION_EMAIL_FROM="Estás Para Más <hola@tudominio.com>"
RESEND_API_KEY=
CONFIRMATION_EMAIL_FROM=
